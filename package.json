{
  "name": "chrome-task-manager",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "description": "Менеджер Задач — расширение Chrome со списком задач в боковой панели",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "validate": "node scripts/validate.mjs",
    "load-test": "node scripts/load-test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run validate",
    "clean": "rm -rf dist release node_modules/.tmp",
    "report": "node report.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.5",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.1.1"
  }
}
